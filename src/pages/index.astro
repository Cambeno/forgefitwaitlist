</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Living mockup: workout timer ticks up, rest counts down.
  if (!reduceMotion) {
    let workoutS = 41 * 60 + 20;
    let restS = 47;
    const fmt = (s: number) => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    const timerEl = document.getElementById('live-timer');
    const restEl = document.getElementById('live-rest');
    setInterval(() => {
      workoutS += 1;
      restS = restS <= 1 ? 90 : restS - 1;
      if (timerEl) timerEl.textContent = fmt(workoutS);
      if (restEl) restEl.textContent = fmt(restS);
    }, 1000);
  }

  // Rings sweep to value when revealed.
  const ringIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const p = en.target.getAttribute('data-p')!;
        requestAnimationFrame(() => {
          (en.target as HTMLElement).style.setProperty('--p', p);
        });
        ringIo.unobserve(en.target);
      });
    },
    { threshold: 0.4 }
  );
  document.querySelectorAll<HTMLElement>('.ring[data-p]').forEach((el) => {
    if (reduceMotion) el.style.setProperty('--p', el.getAttribute('data-p')!);
    else ringIo.observe(el);
  });

  // Forge embers: drifting sparks in the hero.
  (function embers() {
    if (reduceMotion) return;
    const canvas = document.getElementById('embers') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const hero = canvas.parentElement!;
    let w = 0, h = 0, raf = 0;
    const N = 26;
    type P = { x: number; y: number; r: number; vy: number; vx: number; a: number; tw: number };
    const ps: P[] = [];
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function size() {
      w = canvas!.width = hero.offsetWidth;
      h = canvas!.height = hero.offsetHeight;
    }
    function spawn(p: P, first: boolean) {
      p.x = rand(0, w);
      p.y = first ? rand(0, h) : h + 10;
      p.r = rand(0.8, 2.4);
      p.vy = rand(0.15, 0.55);
      p.vx = rand(-0.12, 0.12);
      p.a = rand(0.08, 0.4);
      p.tw = rand(0.002, 0.01);
    }
    for (let i = 0; i < N; i++) {
      const p = {} as P;
      spawn(p, true);
      ps.push(p);
    }
    function tick() {
      ctx!.clearRect(0, 0, w, h);
      for (const p of ps) {
        p.y -= p.vy;
        p.x += p.vx;
        p.a += p.tw * (Math.random() > 0.5 ? 1 : -1);
        if (p.a < 0.04) p.a = 0.04;
        if (p.a > 0.45) p.a = 0.45;
        if (p.y < -10 || p.x < -10 || p.x > w + 10) spawn(p, false);
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = 'rgba(181,242,61,' + p.a.toFixed(3) + ')';
        ctx!.fill();
      }
      raf = requestAnimationFrame(tick);
    }
    size();
    tick();
    window.addEventListener('resize', size);
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(tick);
    });
  })();
</script>

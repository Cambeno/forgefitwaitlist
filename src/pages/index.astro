---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';

const featured = (await getCollection('guides'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ForgeFit',
    url: 'https://forgefit.fitness',
    logo: 'https://forgefit.fitness/forge-logo.png',
    email: 'hello@forgefit.fitness',
    founder: { '@type': 'Person', name: 'Campbell Blair' },
    address: { '@type': 'PostalAddress', addressCountry: 'AU' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ForgeFit: AI Gym Coach',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS',
    description:
      'AI-powered workout tracker with an AI coach that reads your training history, recovery-based programming, and gem-tier ranks earned from real lifted volume.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<Base
  title="ForgeFit: The AI Gym Coach In Your Pocket"
  description="Log every set in three taps, train around your recovery, and climb from Copper to Prismatic. ForgeFit is the workout tracker that actually coaches you. Join the waitlist."
  schema={schema}
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-label="ForgeFit">
    <canvas id="embers" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="hero-grid">
        <!-- The headline spans the full grid so it is measured against the
             page width, not the narrow left column. At 88px "Train smarter."
             needs 814px; the column is only 512px, which was breaking it onto
             four ragged lines. -->
        <div class="hero-head">
          <span class="eyebrow hr hr-1">Launching on the App Store</span>
          <h1>
            <span class="l1 hr hr-2">Train smarter.</span><span class="l2 hr hr-3">Get stronger.</span>
          </h1>
        </div>

        <div class="hero-copy">
          <p class="hero-sub hr hr-4">
            ForgeFit is the workout tracker that actually coaches you. Log every set in seconds, let
            <strong>Ember, your AI coach,</strong> build sessions around your recovery, and climb the
            ranks your volume earns.
          </p>

          <SignupForm class="hr hr-5" />
        </div>

        <!-- Logger mockup -->
        <div class="phone" aria-hidden="true">
          <div class="screen">
            <div class="scr-head">
              <span class="scr-label">ACTIVE WORKOUT</span>
              <span class="scr-timer" id="live-timer">41:20</span>
            </div>
            <div class="scr-title">Push Day</div>
            <div class="ex-card">
              <div class="ex-name">BENCH PRESS</div>
              <div class="ex-last">Last: 80kg × 8 · PR 85kg</div>
              <div class="srow done">
                <span class="sbadge">1</span>
                <span class="scell">80</span>
                <span class="scell">8 <span class="rpe-tag">@8</span></span>
                <span class="scheck">✓</span>
              </div>
              <div class="srow done">
                <span class="sbadge">2</span>
                <span class="scell">82.5</span>
                <span class="scell">6 <span class="rpe-tag">@9</span></span>
                <span class="scheck">✓</span>
              </div>
              <div class="srow ghost">
                <span class="sbadge">3</span>
                <span class="scell"><b>82.5</b></span>
                <span class="scell"><b>6</b></span>
                <span class="scheck"></span>
              </div>
              <div class="rest">⏱ <b id="live-rest">0:47</b> <span>Rings even when locked</span></div>
            </div>
          </div>
        </div>

        <!-- Full-width stat band. Cramped into the 512px copy column it was
             four wrapping labels; across the page it reads as a band. -->
        <div class="facts">
          <div class="fact rv"><b>3 taps</b><span>to log a set</span></div>
          <div class="fact rv"><b>140+</b><span>exercises built in</span></div>
          <div class="fact rv"><b>7 ranks</b><span>Copper to Prismatic</span></div>
          <div class="fact rv"><b>35</b><span>achievements to earn</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Marquee ──────────────────────────────────────────── -->
  <div class="marquee" aria-hidden="true">
    <div class="mq-track">
      <span>Log</span><span class="solid">Forge</span><span>Rank up</span><span class="solid">Outlift</span
      ><span>Log</span><span class="solid">Forge</span><span>Rank up</span><span class="solid">Outlift</span
      ><span>Log</span><span class="solid">Forge</span><span>Rank up</span><span class="solid">Outlift</span
      ><span>Log</span><span class="solid">Forge</span><span>Rank up</span><span class="solid">Outlift</span>
    </div>
  </div>

  <!-- ── Logger ───────────────────────────────────────────── -->
  <section aria-label="The logger" id="logger">
    <div class="wrap sec-grid">
      <div class="sec-copy rv">
        <p class="kicker">The Logger</p>
        <h2>Between sets is for resting. Not menus.</h2>
        <p>
          Built for one thumb, sweaty hands, and short windows between sets. Everything a serious log
          needs, nothing that slows you down.
        </p>
        <ul class="feat-list">
          <li>
            <b>Last session, right there.</b>&nbsp;<span
              >Every exercise shows your previous weight, reps and PR inline. Beat it.</span
            >
          </li>
          <li>
            <b>One-tap sets.</b>&nbsp;<span
              >Empty set plus tick logs last session's numbers. Progressive overload in a single tap.</span
            >
          </li>
          <li>
            <b>A rest timer that follows you.</b>&nbsp;<span
              >Fires on your lock screen, and you can log the next set straight from the notification.</span
            >
          </li>
          <li>
            <b>Plate math, done.</b>&nbsp;<span
              >Type a weight, see the per-side plate breakdown instantly.</span
            >
          </li>
          <li>
            <b>Lifter-grade detail.</b>&nbsp;<span
              >RPE tags, warmup, drop and failure sets, supersets, custom exercises.</span
            >
          </li>
        </ul>
      </div>
      <div class="sec-visual rv" aria-hidden="true">
        <div class="chat" style="max-width:380px">
          <div class="ex-card" style="background:var(--bg)">
            <div class="ex-name">SQUAT</div>
            <div class="ex-last">Last: 120kg × 5 · PR 130kg</div>
            <div class="srow ghost">
              <span class="sbadge">1</span>
              <span class="scell"><b>120</b></span>
              <span class="scell"><b>5</b></span>
              <span class="scheck"></span>
            </div>
          </div>
          <div class="rest" style="margin-top:14px">
            ⏱ <b>1:30</b> <span>Log next set from lock screen</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ember ────────────────────────────────────────────── -->
  <!-- Deliberately centred rather than another two-column row. Three
       identical split sections in a row read as a template; this one is the
       product's headline idea, so it gets a different shape and more air. -->
  <section aria-label="Ember AI coach" id="ember" class="sec-tall sec-center">
    <div class="wrap">
      <div class="ember-head rv">
        <svg class="flame" viewBox="0 0 48 64" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="flameOuter" x1="24" y1="3" x2="24" y2="56" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#e2ff8f" />
              <stop offset="0.42" stop-color="#b5f23d" />
              <stop offset="1" stop-color="#4c7f12" />
            </linearGradient>
            <linearGradient id="flameCore" x1="24" y1="28" x2="24" y2="55" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="1" stop-color="#e6ff9c" />
            </linearGradient>
          </defs>
          <path
            class="f-outer"
            fill="url(#flameOuter)"
            d="M24 3c2 11 9 15 13 22 3.5 6 4 11 4 14 0 9.4-7.6 17-17 17S7 48.4 7 39c0-6 2.5-11.5 6-16 .6 3 2.4 5 4.6 5.6C15.5 20 19 9 24 3Z"
          />
          <path
            class="f-core"
            fill="url(#flameCore)"
            d="M24 29c1.2 6 5 8.5 6.6 12 1 2.2 1.4 4 1.4 5.4 0 4.2-3.6 7.6-8 7.6s-8-3.4-8-7.6c0-2.8 1.2-5.4 3-7.4.4 1.6 1.2 2.6 2.4 3-1.4-4.4.2-9.6 2.6-13Z"
          />
        </svg>

        <p class="kicker">Ember, your AI coach</p>
        <h2>A coach that has actually read your training log.</h2>
        <p class="ember-sub">
          Ember isn't a chatbot with a six-pack avatar. It knows your history, your PRs and your plan,
          and it programs today's session from what your body did this week.
        </p>
      </div>

      <div class="chat rv" aria-hidden="true">
        <div class="bubble user">What should I train today?</div>
        <div class="bubble ai">
          Recovery's at <b>72%</b>, you're primed. Push day: your bench is 2.5kg off a PR, so we're
          opening heavy. 4×6 at 80kg, then chase it.
        </div>
      </div>

      <div class="ember-points rv">
        <div class="ep">
          <b>Ask anything</b>
          <span>Straight answers built on your own numbers, not generic templates.</span>
        </div>
        <div class="ep">
          <b>Full workouts in seconds</b>
          <span>Generated to your goal, your equipment and how recovered you are today.</span>
        </div>
        <div class="ep">
          <b>Program critique</b>
          <span>Paste any program and get told what works, what's broken and what to change.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recovery ─────────────────────────────────────────── -->
  <section aria-label="Recovery and readiness" id="recovery">
    <div class="wrap sec-grid">
      <div class="sec-copy rv">
        <p class="kicker">Recovery-driven training</p>
        <h2>Go heavy when you're primed. Back off when you're not.</h2>
        <p>
          Connect Apple Health and ForgeFit reads your sleep, HRV and resting heart rate into one
          readiness score, then tells you how hard today should be. Your AI-generated sessions scale
          with it automatically.
        </p>
        <ul class="feat-list">
          <li><b>Recovery, strain and heat</b>&nbsp;<span>at a glance, every morning.</span></li>
          <li>
            <b>No junk volume.</b>&nbsp;<span
              >Under-recovered days get lighter loads and smarter work, automatically.</span
            >
          </li>
          <li>
            <b>Private by design.</b>&nbsp;<span
              >Health data is read-only, never sold, never used for ads.</span
            >
          </li>
        </ul>
      </div>
      <div class="sec-visual rv" aria-hidden="true">
        <div class="rings">
          <div class="ring-item">
            <div class="ring" style="--c:var(--lime)" data-p="72"><b>72</b></div>
            <span>Recovery</span>
          </div>
          <div class="ring-item">
            <div class="ring" style="--c:#60A5FA" data-p="54"><b>11.2</b></div>
            <span>Strain</span>
          </div>
          <div class="ring-item">
            <div class="ring" style="--c:#FF9F0A" data-p="85"><b>6</b></div>
            <span>Heat</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ranks ────────────────────────────────────────────── -->
  <section aria-label="Ranks and achievements" id="ranks">
    <div class="wrap">
      <div class="ranks-head rv">
        <p class="kicker">The Forge</p>
        <h2>Copper to Prismatic. Earned, never given.</h2>
        <p>
          Your rank is forged from real lifted volume, not streaks or logins. Seven tiers, thirty-five
          achievements, and a trophy case that means something because you can't buy it.
        </p>
      </div>
      <div class="gems rv">
        <div class="gem"><img src="/ranks/copper.webp" alt="Copper rank gem" loading="lazy" /><span>Copper</span></div>
        <div class="gem"><img src="/ranks/silver.webp" alt="Silver rank gem" loading="lazy" /><span>Silver</span></div>
        <div class="gem"><img src="/ranks/gold.webp" alt="Gold rank gem" loading="lazy" /><span>Gold</span></div>
        <div class="gem"><img src="/ranks/diamond.webp" alt="Diamond rank gem" loading="lazy" /><span>Diamond</span></div>
        <div class="gem"><img src="/ranks/emerald.webp" alt="Emerald rank gem" loading="lazy" /><span>Emerald</span></div>
        <div class="gem"><img src="/ranks/ruby.webp" alt="Ruby rank gem" loading="lazy" /><span>Ruby</span></div>
        <div class="gem prismatic">
          <img src="/ranks/prismatic.webp" alt="Prismatic rank gem" loading="lazy" /><span>Prismatic</span>
        </div>
      </div>
      <div class="trophies rv">
        <img src="/trophies/bench_prismatic.webp" alt="Prismatic bench press trophy" loading="lazy" />
        <img src="/trophies/squat_prismatic.webp" alt="Prismatic squat trophy" loading="lazy" />
        <img src="/trophies/deadlift_prismatic.webp" alt="Prismatic deadlift trophy" loading="lazy" />
        <img src="/trophies/pullup_prismatic.webp" alt="Prismatic pull-up trophy" loading="lazy" />
        <img src="/trophies/pushup_prismatic.webp" alt="Prismatic push-up trophy" loading="lazy" />
      </div>
      <p class="troph-note rv">The Prismatic trophy case. Bench, squat, deadlift, pull-up, push-up.</p>
    </div>
  </section>

  <!-- ── Guides (SEO hub) ─────────────────────────────────── -->
  <section aria-label="Training guides" id="guides">
    <div class="wrap">
      <div class="guides-head rv">
        <div>
          <p class="kicker">Free training guides</p>
          <h2>Pick a split. Start Monday.</h2>
        </div>
        <p>
          Full programmes with the sets, reps and progression written out: no email needed to read
          them.
        </p>
      </div>
      <div class="guide-grid">
        {
          featured.map((g) => (
            <a class="guide-card rv" href={`/blog/${g.id}`}>
              <span class="g-days">{g.data.daysLabel}</span>
              <h3>{g.data.cardTitle}</h3>
              <p>{g.data.blurb}</p>
              <span class="g-more">Read the guide →</span>
            </a>
          ))
        }
      </div>
      <p class="guides-all rv">
        <a href="/blog">All training guides</a> &middot;
        <a href="/exercises">Exercise library</a>
      </p>
    </div>
  </section>

  <!-- ── Final CTA ────────────────────────────────────────── -->
  <section class="final" id="join" aria-label="Join the waitlist">
    <div class="wrap rv">
      <h2>The forge <em>is hot.</em></h2>
      <p>ForgeFit launches soon on the App Store. Join the waitlist and be first through the door.</p>
      <SignupForm hint="No spam. One email when it's your turn." />
    </div>
  </section>
</Base>

<style>
  /* ── Hero ───────────────────────────────────────────── */
  .hero {
    padding: clamp(56px, 9vw, 110px) 0 clamp(48px, 7vw, 90px);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10%;
    background:
      radial-gradient(52% 42% at 72% 40%, rgba(181, 242, 61, 0.1), transparent 65%),
      radial-gradient(40% 34% at 12% 8%, rgba(181, 242, 61, 0.05), transparent 60%);
    pointer-events: none;
  }
  #embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero .wrap {
    position: relative;
  }

  .hr {
    opacity: 0;
    transform: translateY(26px);
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hr-1 { animation-delay: 0.05s; }
  .hr-2 { animation-delay: 0.15s; }
  .hr-3 { animation-delay: 0.28s; }
  .hr-4 { animation-delay: 0.4s; }
  .hr-5 { animation-delay: 0.52s; }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }

  h1 :global(.l1),
  h1 :global(.l2) { display: block; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    column-gap: clamp(32px, 5vw, 64px);
    row-gap: clamp(28px, 4vw, 44px);
    align-items: center;
  }
  /* Full-bleed headline row: gives the display type the whole page width to
     size against instead of a 512px column. */
  .hero-head {
    grid-column: 1 / -1;
  }
  .hero-copy {
    min-width: 0;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
    margin-bottom: 22px;
  }
  .eyebrow::before {
    content: '';
    width: 22px;
    height: 2px;
    background: var(--lime);
  }
  /* Mobile-first sizing, derived from measurement rather than taste.
     The old 46px floor made "Train smarter." 416px wide inside a 350px column
     on a 390px phone, so each line wrapped and the headline broke into four
     ragged lines. Floor and slope are set so both lines stay unbroken from
     320px (the narrowest phone still in use) upward. */
  h1 {
    font-weight: 900;
    font-size: clamp(30px, 9.4vw, 88px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  h1 :global(.l2) { color: var(--lime); }
  .hero-sub {
    margin-top: 20px;
    font-size: clamp(16.5px, 4.3vw, 19px);
    line-height: 1.5;
    color: var(--text-2);
    max-width: 46ch;
  }
  .hero-sub strong {
    color: var(--text);
    font-weight: 600;
  }

  /* The stat strip was four grey numbers on a grey rule and read as filler.
     Lime numerals and vertical rules turn it into a graphic band that carries
     real weight on a phone, where it sits directly under the CTA. */
  .facts {
    grid-column: 1 / -1;
    margin-top: clamp(20px, 3vw, 36px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .fact {
    padding: clamp(16px, 3vw, 22px) clamp(10px, 2vw, 18px);
    border-left: 1px solid var(--line);
  }
  .fact:first-child { border-left: 0; padding-left: 0; }
  .fact b {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(24px, 6.2vw, 32px);
    letter-spacing: -0.03em;
    color: var(--lime);
    display: block;
    /* "7 ranks" wraps to two lines at mid widths while the other three stay on
       one, which staggers the row. Keep every stat on a single line. */
    white-space: nowrap;
  }
  .fact span {
    display: block;
    margin-top: 4px;
    font-size: clamp(11.5px, 3vw, 13px);
    line-height: 1.35;
    color: var(--text-3);
  }

  /* ── Marquee ────────────────────────────────────────── */
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
    background: var(--bg);
  }
  .mq-track {
    display: inline-block;
    animation: mq 26s linear infinite;
    will-change: transform;
  }
  .mq-track span {
    font-family: var(--display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4.4vw, 52px);
    letter-spacing: -0.01em;
    padding-right: 18px;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(181, 242, 61, 0.55);
  }
  .mq-track span.solid {
    color: var(--lime);
    -webkit-text-stroke: 0;
  }
  @keyframes mq {
    to { transform: translateX(-50%); }
  }

  /* ── Phone mockup ───────────────────────────────────── */
  .phone {
    --rot: 2.5deg;
    width: min(320px, 82vw);
    margin: 0 auto;
    /* Tinted toward the brand hue rather than pure #000. */
    background: #050507;
    border-radius: 44px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    /* The mockup was near-invisible dark-on-dark. A tighter lime halo lifts it
       off the background without turning into decorative glow. */
    box-shadow:
      0 40px 90px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(181, 242, 61, 0.06),
      0 0 90px -20px rgba(181, 242, 61, 0.32);
    transform: rotate(var(--rot));
    /* `both`, not `backwards`. With `backwards` the end state was never
       retained, so the mockup sat at the keyframe's opacity:0 start and the
       hero's main visual was invisible on every device. */
    animation:
      phoneIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both,
      bob 7s ease-in-out 1.6s infinite;
  }
  /* Rotation goes through a custom property so the mobile override actually
     applies. Previously `.phone { transform: rotate(0deg) }` under 860px was
     silently ignored, because the running `bob` animation overrides a plain
     transform declaration. */
  /* Deliberately does NOT animate opacity. The hero's main visual must never
     depend on an animation completing — when this keyframe controlled opacity,
     any stall left the mockup at `opacity: 0` and the hero simply had a hole in
     it. It now slides into place and is visible either way. */
  @keyframes phoneIn {
    from { transform: rotate(var(--rot)) translateY(34px); }
    to { transform: rotate(var(--rot)) translateY(0); }
  }
  @keyframes bob {
    0%, 100% { transform: rotate(var(--rot)) translateY(0); }
    50% { transform: rotate(calc(var(--rot) * 0.88)) translateY(-10px); }
  }
  .screen {
    background: var(--bg);
    border-radius: 34px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 18px 14px 16px;
    font-size: 13px;
  }
  .scr-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .scr-label {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #8a929b;
    font-weight: 700;
  }
  .scr-timer {
    font-family: var(--display);
    font-weight: 800;
    font-size: 15px;
    color: var(--lime);
    font-variant-numeric: tabular-nums;
  }
  .scr-title {
    font-family: var(--display);
    font-weight: 900;
    font-size: 21px;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .ex-card {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 12px;
  }
  .ex-name {
    font-family: var(--display);
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 0.03em;
  }
  .ex-last { font-size: 10.5px; color: var(--text-3); margin: 3px 0 10px; }
  .srow {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .sbadge {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    flex: none;
    display: grid;
    place-items: center;
